{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "queues": {
      "maxPollingInterval": "00:00:10"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "Host.Results": "Warning",
      "Host.Aggregator": "Information"
    }
  },
  "functionTimeout": "00:10:00"
}