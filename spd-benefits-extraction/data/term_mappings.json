  "patterns": {
    "_description": "Regex patterns for matching. Use when exact match isn't sufficient.",
    
    "network_tier": [
      {"pattern": "\\bin[- ]?net\\b", "maps_to": "In-Network"},
      {"pattern": "\\bout[- ]?of[- ]?net\\b", "maps_to": "Out-of-Network"},
      {"pattern": "\\bnon[- ]?par\\b", "maps_to": "Out-of-Network"},
      {"pattern": "\\btier\\s*[1i]\\b", "maps_to": "In-Network"},
      {"pattern": "\\btier\\s*[2-9]\\b", "maps_to": "Out-of-Network"},
      {"pattern": "\\bppo\\b", "maps_to": "In-Network"},
      {"pattern": "\\bhmo\\b", "maps_to": "In-Network"}
    ],
    
    "service_category": [
      {"pattern": "emergency\\s+(?:and|&)\\s+urgent\\s+care(?:\\s+services?)?", "maps_to": "Emergency Services", "_comment": "Combined emergency/urgent category headers"},
      {"pattern": "physician\\s+services?", "maps_to": "Primary Care", "_comment": "Physician Services category header"},
      {"pattern": "office\\s+visit\\s+(?:for\\s+)?(?:injury|illness)", "maps_to": "Primary Care", "_comment": "Office visit for injury/illness parent header"},
      {"pattern": "prevent|wellness|routine\\s+(?:physical|exam)|well[- ]?(?:child|baby|woman)", "maps_to": "Preventive Care"},
      {"pattern": "annual\\s+(?:physical|exam|checkup)|yearly\\s+(?:physical|exam)|periodic\\s+health", "maps_to": "Preventive Care"},
      {"pattern": "screenings?|colonoscopy|mammogram|pap\\s+(?:smear|test)", "maps_to": "Preventive Care"},
      {"pattern": "immuniz|vaccin|shots?\\s+(?:and|&)?\\s*immuniz", "maps_to": "Immunizations"},
      {"pattern": "flu\\s+shot|covid[- ]?19\\s+(?:vaccine|shot)|childhood\\s+(?:vaccines?|immuniz)", "maps_to": "Immunizations"},
      {"pattern": "primary\\s+care|pcp\\b|office\\s+visit|physician\\s+(?:office|visit)", "maps_to": "Primary Care"},
      {"pattern": "doctor(?:'?s)?\\s+(?:office|visit)|medical\\s+(?:office|visit)|virtual\\s+visit", "maps_to": "Primary Care"},
      {"pattern": "telehealth|telemedicine|video\\s+visit|e-?visit", "maps_to": "Telehealth"},
      {"pattern": "specialist|referral\\s+(?:to\\s+)?specialist", "maps_to": "Specialist Services"},
      {"pattern": "consultation|consult(?:ing)?\\s+(?:physician|doctor)", "maps_to": "Specialist Services"},
      {"pattern": "emergency|\\ber\\b|\\bed\\b|emergency\\s+(?:room|department)", "maps_to": "Emergency Services"},
      {"pattern": "urgent\\s+care|walk[- ]?in\\s+(?:clinic|care)|retail\\s+clinic", "maps_to": "Urgent Care"},
      {"pattern": "convenience\\s+care|minute\\s+clinic", "maps_to": "Urgent Care"},
      {"pattern": "inpatient.*hosp|hospital.*inpatient|room\\s+(?:and|&)\\s+board", "maps_to": "Inpatient Hospital Services"},
      {"pattern": "hospital\\s+stay|overnight\\s+(?:hospital|stay)|admission\\s+(?:to\\s+)?hospital", "maps_to": "Inpatient Hospital Services"},
      {"pattern": "intensive\\s+care|icu\\b|critical\\s+care", "maps_to": "Inpatient Hospital Services"},
      {"pattern": "outpatient.*hosp|hospital.*outpatient|ambulatory\\s+surg", "maps_to": "Outpatient Hospital Services"},
      {"pattern": "same[- ]?day\\s+surgery|day\\s+surgery|outpatient\\s+surgery", "maps_to": "Outpatient Hospital Services"},
      {"pattern": "operating\\s+room|surgical\\s+(?:facility|center)|surgery\\s+(?:center|facility)", "maps_to": "Surgery Services"},
      {"pattern": "surgeon|surgical\\s+(?:procedure|service)", "maps_to": "Surgery Services"},
      {"pattern": "anesthesia|anesthetic", "maps_to": "Anesthesia Services"},
      {"pattern": "mental\\s+health.*inpatient|inpatient.*(?:mental|psych)", "maps_to": "Mental Health - Inpatient"},
      {"pattern": "psychiatric\\s+(?:hospital|facility|inpatient)|mental\\s+(?:hospital|facility)", "maps_to": "Mental Health - Inpatient"},
      {"pattern": "mental\\s+health|behavioral|psychiatric|therap|counseling", "maps_to": "Mental Health - Outpatient"},
      {"pattern": "psychologist|psychiatrist|psychotherapy|talk\\s+therapy", "maps_to": "Mental Health - Outpatient"},
      {"pattern": "emotional|anxiety|depression\\s+(?:treatment|therapy)|stress\\s+(?:counseling|treatment)", "maps_to": "Mental Health - Outpatient"},
      {"pattern": "substance|alcohol|drug\\s+(?:abuse|treatment)|detox", "maps_to": "Substance Abuse - Outpatient"},
      {"pattern": "chemical\\s+dependency|addiction|opioid|suboxone|methadone", "maps_to": "Substance Abuse - Outpatient"},
      {"pattern": "(?:prenatal|maternity).*care|obstetric|ob[- ]?gyn\\s+(?:prenatal|visit)", "maps_to": "Maternity - Prenatal"},
      {"pattern": "pregnancy|(?:ante)?natal\\s+care|before\\s+delivery", "maps_to": "Maternity - Prenatal"},
      {"pattern": "delivery|labor\\s+(?:and|&)\\s+delivery|childbirth", "maps_to": "Maternity - Delivery"},
      {"pattern": "c[- ]?section|cesarean|vaginal\\s+(?:delivery|birth)|birthing", "maps_to": "Maternity - Delivery"},
      {"pattern": "newborn|after\\s+birth|post[- ]?partum|postnatal", "maps_to": "Newborn Care"},
      {"pattern": "well[- ]?baby|(?:newborn|infant)\\s+(?:care|visit)|nursery", "maps_to": "Newborn Care"},
      {"pattern": "prescription|pharmacy|\\brx\\b|formulary|medications?", "maps_to": "Prescription Drugs"},
      {"pattern": "drug\\s+coverage|covered\\s+drugs?|mail\\s+order\\s+(?:pharmacy|drugs?)", "maps_to": "Prescription Drugs"},
      {"pattern": "generic.*drug|tier\\s*1.*drug|generic\\s+(?:medication|rx)", "maps_to": "Prescription - Generic"},
      {"pattern": "brand.*drug|tier\\s*2.*drug|preferred\\s+brand|formulary\\s+brand", "maps_to": "Prescription - Brand"},
      {"pattern": "non[- ]?formulary|tier\\s*3|non[- ]?preferred\\s+brand", "maps_to": "Prescription - Non-Preferred"},
      {"pattern": "specialty.*drug|tier\\s*4.*drug|specialty\\s+(?:pharmacy|medication)", "maps_to": "Prescription - Specialty"},
      {"pattern": "biologic|self[- ]?inject|infusion\\s+drug", "maps_to": "Prescription - Specialty"},
      {"pattern": "rehab|physical\\s+therapy|\\bpt\\b|occupational\\s+therapy|\\bot\\b|speech\\s+therapy", "maps_to": "Rehabilitation - Outpatient"},
      {"pattern": "habilitation|habilitative|cardiac\\s+(?:rehab|rehabilitation)", "maps_to": "Rehabilitation - Outpatient"},
      {"pattern": "pulmonary\\s+(?:rehab|rehabilitation)|respiratory\\s+therapy", "maps_to": "Rehabilitation - Outpatient"},
      {"pattern": "skilled\\s+nursing|\\bsnf\\b|nursing\\s+(?:facility|home)", "maps_to": "Skilled Nursing Facility"},
      {"pattern": "extended\\s+care|convalescent|sub[- ]?acute", "maps_to": "Skilled Nursing Facility"},
      {"pattern": "home\\s+health|home\\s+(?:care|nursing)|visiting\\s+nurse", "maps_to": "Home Health Care"},
      {"pattern": "home\\s+infusion|private\\s+duty\\s+nursing", "maps_to": "Home Health Care"},
      {"pattern": "hospice|palliative|end[- ]?of[- ]?life", "maps_to": "Hospice Care"},
      {"pattern": "durable\\s+medical|\\bdme\\b|wheelchair|oxygen|crutches", "maps_to": "Durable Medical Equipment"},
      {"pattern": "medical\\s+equipment|cpap|nebulizer|walker|hospital\\s+bed", "maps_to": "Durable Medical Equipment"},
      {"pattern": "prosthetic|orthotic|artificial\\s+limb|brace", "maps_to": "Prosthetics & Orthotics"},
      {"pattern": "orthopedic\\s+(?:device|appliance)|leg\\s+brace|arm\\s+brace", "maps_to": "Prosthetics & Orthotics"},
      {"pattern": "lab(?:oratory)?|blood\\s+(?:test|work)|pathology", "maps_to": "Diagnostic - Lab"},
      {"pattern": "diagnostic\\s+test|urinalysis|chemistry\\s+panel|cbc", "maps_to": "Diagnostic - Lab"},
      {"pattern": "x[- ]?ray|radiograph|chest\\s+x[- ]?ray", "maps_to": "Diagnostic - X-Ray"},
      {"pattern": "mri|ct\\s+scan|pet\\s+scan|nuclear\\s+medicine|advanced\\s+imaging", "maps_to": "Diagnostic - Advanced Imaging"},
      {"pattern": "ultrasound|sonogram|echocardiogram|echo", "maps_to": "Diagnostic - Advanced Imaging"},
      {"pattern": "imaging|radiology|diagnostic\\s+imaging", "maps_to": "Diagnostic - Imaging"},
      {"pattern": "ekg|eeg|ekgs?|electrocardiogram|stress\\s+test", "maps_to": "Diagnostic - Cardiac"},
      {"pattern": "ambulance|(?:emergency\\s+)?transport|air\\s+ambulance", "maps_to": "Ambulance Services"},
      {"pattern": "medical\\s+transport|ground\\s+(?:ambulance|transport)|medevac", "maps_to": "Ambulance Services"},
      {"pattern": "vision|eye\\s+exam|glasses|optometrist|eyewear", "maps_to": "Vision Services"},
      {"pattern": "ophthalmolog|contact\\s+lens|lasik|eye\\s+surgery", "maps_to": "Vision Services"},
      {"pattern": "dental|oral|tooth|teeth|orthodontia|braces", "maps_to": "Dental Services"},
      {"pattern": "routine\\s+dental|dental\\s+checkup|dental\\s+cleaning", "maps_to": "Dental Services"},
      {"pattern": "hearing|audiology|hearing\\s+aid|cochlear", "maps_to": "Hearing Services"},
      {"pattern": "hearing\\s+(?:exam|test|screening)", "maps_to": "Hearing Services"},
      {"pattern": "chiropractic|spinal\\s+manipulation|chiropractor", "maps_to": "Chiropractic Services"},
      {"pattern": "acupuncture|acupuncturist", "maps_to": "Acupuncture"},
      {"pattern": "infertility|ivf|in[- ]?vitro|fertility", "maps_to": "Infertility Treatment"},
      {"pattern": "artificial\\s+insemination|reproductive\\s+(?:assist|service)", "maps_to": "Infertility Treatment"},
      {"pattern": "transplant|organ\\s+transplant|bone\\s+marrow\\s+transplant", "maps_to": "Organ Transplant"},
      {"pattern": "dialysis|renal|kidney\\s+(?:dialysis|treatment)", "maps_to": "Dialysis"},
      {"pattern": "chemotherapy|chemo|oncology|cancer\\s+(?:treatment|therapy)", "maps_to": "Chemotherapy"},
      {"pattern": "radiation\\s+(?:therapy|treatment)|proton\\s+therapy", "maps_to": "Radiation Therapy"},
      {"pattern": "deductible|out[- ]?of[- ]?pocket|\\boop\\b|max(?:imum)?\\s+out[- ]?of[- ]?pocket", "maps_to": "Deductibles & Out-of-Pocket"},
      {"pattern": "coinsurance\\s+(?:max|limit)|individual\\s+(?:oop|out[- ]?of[- ]?pocket)", "maps_to": "Deductibles & Out-of-Pocket"},
      {"pattern": "family\\s+(?:deductible|oop|out[- ]?of[- ]?pocket)", "maps_to": "Deductibles & Out-of-Pocket"},
      {"pattern": "allergy|allergen|allergy\\s+(?:test|shot|injection)", "maps_to": "Allergy Services"},
      {"pattern": "podiatr|foot\\s+(?:care|doctor)|chiropodist", "maps_to": "Podiatry Services"},
      {"pattern": "pediatric|child(?:ren)?\\s+(?:care|visit|service)", "maps_to": "Pediatric Services"},
      {"pattern": "dermatolog|skin\\s+(?:care|exam|treatment)", "maps_to": "Dermatology Services"},
      {"pattern": "sleep\\s+(?:study|lab|apnea)|polysomnography", "maps_to": "Sleep Services"},
      {"pattern": "infusion|\\biv\\b\\s+(?:therapy|infusion)|injectable|outpatient\\s+infusion", "maps_to": "Infusion Therapy"},
      {"pattern": "genetic\\s+(?:test|counseling|screening)", "maps_to": "Genetic Services"},
      {"pattern": "physical\\s+medicine|\\bpm&r\\b|physiatry", "maps_to": "Physical Medicine"},
      {"pattern": "applied\\s+behavioral|aba\\s+(?:therapy|treatment)|autism", "maps_to": "Autism Services"}
    ],
    
    "coverage_status": [
      {"pattern": "not\\s+covered", "maps_to": "Not Covered"},
      {"pattern": "no\\s+coverage", "maps_to": "Not Covered"},
      {"pattern": "excluded", "maps_to": "Not Covered"},
      {"pattern": "covered\\s+in\\s+full", "maps_to": "Covered in Full"},
      {"pattern": "100\\s*%\\s*covered", "maps_to": "Covered in Full"},
      {"pattern": "no\\s+(?:charge|cost|copay)", "maps_to": "Covered in Full"},
      {"pattern": "\\$\\s*0(?:\\.00)?\\b", "maps_to": "Covered in Full"}
    ],
    
    "after_deductible": [
      {"pattern": "(?:after|subject\\s+to|following)\\s+(?:the\\s+)?(?:plan\\s+)?deductible", "maps_to": "Yes"},
      {"pattern": "ded(?:uctible)?\\s+applies", "maps_to": "Yes"},
      {"pattern": "(?:deductible|ded)\\s+(?:waived|not\\s+applicable|n/?a|does\\s+not\\s+apply)", "maps_to": "No"},
      {"pattern": "no\\s+(?:annual\\s+)?deductible", "maps_to": "No"},
      {"pattern": "waive[ds]?\\s+(?:the\\s+)?ded(?:uctible)?", "maps_to": "No"}
    ],
    
    "preauth_status": [
      {"pattern": "pre[- ]?(?:authorization|certification|auth)\\s+required", "maps_to": "Required"},
      {"pattern": "prior\\s+auth(?:orization)?\\s+required", "maps_to": "Required"},
      {"pattern": "requires?\\s+(?:pre[- ]?)?(?:authorization|approval|pa)", "maps_to": "Required"},
      {"pattern": "must\\s+(?:be\\s+)?pre[- ]?(?:approved|authorized)", "maps_to": "Required"},
      {"pattern": "no\\s+(?:pre[- ]?)?(?:authorization|precert)", "maps_to": "Not Required"},
      {"pattern": "pre[- ]?auth(?:orization)?\\s+not\\s+required", "maps_to": "Not Required"},
      {"pattern": "may\\s+(?:be\\s+)?require|check\\s+with\\s+plan", "maps_to": "May Be Required"}
    ],
    
    "hierarchical_service_patterns": {
      "_description": "Patterns for recognizing parent-child service structures",
      "parent_indicators": [
        {"pattern": "office\\s+visit\\s+(?:for\\s+)?(?:injury|illness)", "_comment": "Office Visit for Injury/Illness parent row"},
